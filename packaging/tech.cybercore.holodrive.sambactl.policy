<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Holodrive's Samba helper. By default it needs an admin password; the
     rule written by install-root.sh (50-holodrive.rules) lets the one user
     who installed Holodrive run it without one, because Holodrive runs as a
     service and has no way to ask. The helper validates everything itself. -->
<policyconfig>
  <vendor>Cybercore Tech</vendor>
  <vendor_url>https://github.com/cybercore-tech/holodrive</vendor_url>
  <action id="tech.cybercore.holodrive.sambactl">
    <description>Manage Samba shares with Holodrive</description>
    <message>Authentication is required to manage Samba shares with Holodrive</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/holodrive-sambactl</annotate>
  </action>
</policyconfig>
