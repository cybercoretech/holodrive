[Unit]
Description=Holodrive — neon web file manager (127.0.0.1, published by tailscale serve)
Documentation=https://github.com/cybercoretech/holodrive
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/holodrive
Restart=on-failure
RestartSec=3
# No NoNewPrivileges=, PrivateTmp= or ProtectSystem= on purpose: the Samba
# panel runs pkexec (setuid) to reach its root helper. In a *user* unit those
# sandbox options put the service in a user namespace, where setuid doesn't
# work ("pkexec must be setuid root").

[Install]
WantedBy=default.target
