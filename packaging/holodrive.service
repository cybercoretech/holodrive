[Unit]
Description=Holodrive — neon web file manager (127.0.0.1, published by tailscale serve)
Documentation=https://github.com/cybercore-tech/holodrive
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/holodrive
Restart=on-failure
RestartSec=3
PrivateTmp=yes
ProtectSystem=full
# No NoNewPrivileges= on purpose: the Samba panel runs pkexec (setuid) to
# reach its root helper, which that setting would block.

[Install]
WantedBy=default.target
